{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engineering-governance:review-record:1",
  "title": "Revision-bound review record",
  "description": "One record per review, bound to one revision. It carries declared metadata: a conforming record is not proof that the review was sound, independent or authentic. Cross-field and external checks (reviewer differs from builder, revision matches the inspected head, references resolve, required review types per trigger) are performed by the evaluator, not by this schema. No raw prompts, transcripts, logs or private data belong in a record. Only outcome cleared is eligible for set counting. Conditional/unavailable records never count. Artifact hashes are verified against externally supplied bounded bytes; references never initiate reads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "policy_version",
    "repository",
    "change_id",
    "review_type",
    "rule_ids",
    "reviewed_revision",
    "builder",
    "reviewer",
    "independence",
    "scope",
    "outcome",
    "no_substantive_challenge",
    "limitations",
    "created_at",
    "authenticity"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "change_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "review_type": {
      "description": "Maps to CODE-021 (specialist), CODE-024 (adversarial), CODE-011/027 (quality) and CODE-025 (principal). The high-risk risk review is the set of these records, not a separate type (CODE-050).",
      "enum": [
        "specialist",
        "adversarial",
        "quality",
        "principal"
      ]
    },
    "specialist": {
      "description": "Project specialist role the concern was mapped to (CODE-021). Required when review_type is specialist.",
      "type": "string",
      "minLength": 1
    },
    "trigger_ids": {
      "description": "Trigger ids from gates.yaml this review covers. Required, non-empty, for specialist reviews so that per-trigger completeness can be checked (CODE-050).",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rule_ids": {
      "description": "Rules this review is offered as evidence for.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CODE-[0-9]{3}$"
      }
    },
    "reviewed_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head_sha"
      ],
      "properties": {
        "head_sha": {
          "$ref": "#/$defs/sha"
        },
        "base_sha": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "builder": {
      "$ref": "#/$defs/identity"
    },
    "reviewer": {
      "$ref": "#/$defs/identity"
    },
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "shared_context_with_builder",
        "builder_conclusions_as_premises",
        "credential_separation"
      ],
      "properties": {
        "basis": {
          "description": "none = self-review; it can never clear triggered work. separate_agent_session = a fresh dispatched agent session with a bounded assignment. different_model_family = reviewer model family differs from the builder's. different_human = a human other than the builder.",
          "enum": [
            "none",
            "separate_agent_session",
            "different_model_family",
            "different_human"
          ]
        },
        "shared_context_with_builder": {
          "description": "True if the reviewer received the builder's reasoning, transcript or conclusions as input.",
          "type": "boolean"
        },
        "same_model_as_builder": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "same_model_family_as_builder": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        },
        "builder_conclusions_as_premises": {
          "type": "boolean"
        },
        "credential_separation": {
          "enum": [
            "separate",
            "shared",
            "unknown"
          ],
          "description": "Declared state, not proof; shared/unknown cannot count toward independent clearance."
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignment"
      ],
      "properties": {
        "assignment": {
          "type": "string",
          "minLength": 1
        },
        "paths_in_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not_in_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "artifacts_inspected": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "account_reviewed": {
      "description": "The drafted user-facing account reviewed under CODE-025. Required for principal reviews.",
      "$ref": "#/$defs/artifact"
    },
    "claims_examined": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "verdict",
          "connecting_explanation",
          "evidence"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": [
              "supported",
              "not_supported",
              "insufficient_evidence"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/artifact"
            },
            "minItems": 1
          },
          "connecting_explanation": {
            "description": "How the evidence decides the actual claim (CODE-004, CODE-005).",
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "counterexamples_attempted": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "method",
          "outcome"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "held",
              "refuted",
              "not_testable"
            ]
          },
          "resolution": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "description",
          "disposition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "enum": [
                  "fixed",
                  "deferred_with_owner",
                  "rejected_with_rationale",
                  "open"
                ]
              },
              "rationale": {
                "type": "string"
              },
              "decided_by": {
                "$ref": "#/$defs/identity"
              },
              "reference": {
                "type": "string"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "state": {
                      "enum": [
                        "deferred_with_owner",
                        "rejected_with_rationale"
                      ]
                    }
                  },
                  "required": [
                    "state"
                  ]
                },
                "then": {
                  "required": [
                    "rationale",
                    "decided_by"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    "no_substantive_challenge": {
      "description": "True only when the review found nothing above info severity. Do not manufacture a contribution (CODE-025).",
      "type": "boolean"
    },
    "outcome": {
      "enum": [
        "cleared",
        "cleared_with_conditions",
        "not_cleared",
        "unavailable"
      ]
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unavailable_reason": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "description": "What this review did not check. Always required, never empty.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "supersedes": {
      "type": "string",
      "minLength": 1
    },
    "authenticity": {
      "description": "How the record's origin is established. A record cannot assert that it is verified; the evaluator assigns verification outside the record.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis"
      ],
      "properties": {
        "basis": {
          "enum": [
            "declared",
            "platform_attributed",
            "signed"
          ]
        },
        "reference": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review_type": {
            "const": "specialist"
          }
        },
        "required": [
          "review_type"
        ]
      },
      "then": {
        "required": [
          "specialist",
          "trigger_ids"
        ],
        "properties": {
          "trigger_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reviewer": {
            "properties": {
              "kind": {
                "const": "agent"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "reviewer"
        ]
      },
      "then": {
        "properties": {
          "independence": {
            "required": [
              "same_model_as_builder",
              "same_model_family_as_builder"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_type": {
            "const": "principal"
          }
        },
        "required": [
          "review_type"
        ]
      },
      "then": {
        "required": [
          "account_reviewed"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "cleared"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "artifacts_inspected",
          "claims_examined"
        ],
        "properties": {
          "artifacts_inspected": {
            "minItems": 1
          },
          "claims_examined": {
            "minItems": 1,
            "not": {
              "contains": {
                "type": "object",
                "properties": {
                  "verdict": {
                    "enum": [
                      "not_supported",
                      "insufficient_evidence"
                    ]
                  }
                },
                "required": [
                  "verdict"
                ]
              }
            }
          },
          "independence": {
            "properties": {
              "basis": {
                "not": {
                  "const": "none"
                }
              }
            }
          },
          "findings": {
            "not": {
              "contains": {
                "type": "object",
                "properties": {
                  "severity": {
                    "enum": [
                      "high",
                      "critical"
                    ]
                  },
                  "disposition": {
                    "type": "object",
                    "properties": {
                      "state": {
                        "const": "open"
                      }
                    },
                    "required": [
                      "state"
                    ]
                  }
                },
                "required": [
                  "severity",
                  "disposition"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_type": {
            "const": "adversarial"
          },
          "outcome": {
            "const": "cleared"
          }
        },
        "required": [
          "review_type",
          "outcome"
        ]
      },
      "then": {
        "required": [
          "counterexamples_attempted"
        ],
        "properties": {
          "counterexamples_attempted": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "cleared_with_conditions"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "conditions"
        ],
        "properties": {
          "conditions": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "unavailable"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "unavailable_reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "not": {
              "const": "unavailable"
            }
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "if": {
          "properties": {
            "no_substantive_challenge": {
              "const": true
            }
          },
          "required": [
            "no_substantive_challenge"
          ]
        },
        "then": {
          "properties": {
            "findings": {
              "not": {
                "contains": {
                  "type": "object",
                  "properties": {
                    "severity": {
                      "enum": [
                        "low",
                        "medium",
                        "high",
                        "critical"
                      ]
                    }
                  },
                  "required": [
                    "severity"
                  ]
                }
              }
            }
          }
        },
        "else": {
          "required": [
            "findings"
          ],
          "properties": {
            "findings": {
              "minItems": 1
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "cleared"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "conditions": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "specification",
            "diff",
            "test_output",
            "document",
            "source_file",
            "external_source",
            "other"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "revision": {
          "$ref": "#/$defs/sha"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "provenance": {
      "description": "Declared by the tool; not proof of what ran.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "model",
        "tool_version"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "tool_version": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "configuration_ref": {
          "type": "string"
        },
        "model_family": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "agent"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "agent"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "provenance",
              "session_id"
            ]
          }
        }
      ]
    }
  }
}
